# Local development server settings.
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:4000

# Leave this as /api when the deployed web server proxies /api to the Express API.
# For a separately hosted API, set this to its public URL, for example:
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api
