# Copy to server/.env and fill in deployment secrets. Never commit server/.env.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Use an absolute path in production when the application runs from a managed service.
SQLITE_PATH=./server/data/acet.sqlite
# PostgreSQL/Supabase connection string format: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=

DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_PASSWORD=
# Generate a long, unique value for every deployed environment.
JWT_SECRET=

# Optional AI diagnostics
GROQ_API_KEY=

# Optional email recovery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS recovery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
